# NavPro Fleet Server environment. Copy to .env and fill in.
# Never commit .env.

# --- site identity -----------------------------------------------------------
# The server's static LAN IP (assign a DHCP reservation). Robots connect to
# tcp/<LAN_IP>:7447 (zenoh) and http://<LAN_IP>/ (API, provisioning).
LAN_IP=192.168.1.10
TZ=Asia/Kolkata

# Fleet name used for RMF config generation and the fleet adapter.
FLEET_NAME=navpro

# Fixed ROS domain inside the rmf-core container (never crosses the bridge).
ROS_DOMAIN_ID=77

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=navpro
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=navpro

# --- platform auth -----------------------------------------------------------
# Initial admin user (seeded on first start; change password after login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Shared site secret robots present during first-boot provisioning/registration
# (header X-Provisioning-Token). Same value for every robot at this site —
# operators enter it on the robot hotspot form. Not a human login password.
# Rotate per site.
PROVISIONING_TOKEN=change-me-provisioning

# --- observability -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Absolute host path to keys/ (jwt-public.pem, jwt-private.pem).
# Required so Apply Building → rmf-reloader never mounts empty /workdir/keys.
NAVPRO_KEYS_DIR=/absolute/path/to/navpro-fleet-server/keys

# --- deferred (uncomment services in docker-compose.yml first) ---------------
# MQTT_USER=factory
# MQTT_PASSWORD=change-me-mqtt

